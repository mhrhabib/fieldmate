<div class="w-full max-w-md">
  <form id="waitlist-form" class="flex flex-col gap-2.5 sm:flex-row">
    <input
      type="email"
      id="waitlist-email"
      placeholder="you@business.com"
      required
      autocomplete="email"
      class="w-full flex-1 !border-white/15 !bg-white/5 !text-white placeholder:text-white/40 sm:w-auto"
    />
    <button class="btn whitespace-nowrap" type="submit">Get Started</button>
  </form>
  <p id="waitlist-msg" class="mt-3 text-[13px] text-white/50"></p>
</div>

<script>
  // This <script> tag is bundled by Astro and shipped ONLY on pages that use
  // this component — the rest of the static page stays JS-free.
  const apiUrl = import.meta.env.PUBLIC_API_URL;
  const form = document.querySelector<HTMLFormElement>("#waitlist-form");
  const msg = document.querySelector<HTMLParagraphElement>("#waitlist-msg");
  const button = form?.querySelector("button");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const email = (document.querySelector<HTMLInputElement>("#waitlist-email"))?.value ?? "";
    if (!msg || !button) return;

    button.disabled = true;
    msg.textContent = "Joining…";

    try {
      const res = await fetch(`${apiUrl}/api/waitlist`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email }),
      });

      if (res.status === 201) {
        msg.textContent = "You're on the list — thanks!";
        form.reset();
      } else if (res.status === 409) {
        msg.textContent = "That email is already on the list.";
      } else {
        msg.textContent = "Something went wrong. Try again in a moment.";
      }
    } catch {
      msg.textContent = "Couldn't reach the API. Is it running on " + apiUrl + "?";
    } finally {
      button.disabled = false;
    }
  });
</script>
