---
const lineItems = [
  { label: "Labor", value: "$450" },
  { label: "Materials", value: "$280" },
  { label: "Tax", value: "$73" },
];
---

<section class="py-20 sm:py-28">
  <div class="mx-auto max-w-wrap px-6">
    <div class="reveal mx-auto max-w-2xl text-center">
      <h2 class="text-balance text-[1.9rem] font-semibold tracking-tight text-ink sm:text-[2.4rem]">
        Turn completed work into revenue.
      </h2>
    </div>

    <div class="mt-14 grid gap-6 sm:grid-cols-2 sm:max-w-3xl sm:mx-auto">
      <!-- Quote -->
      <div class="reveal reveal-delay-1 rounded-2xl border border-line bg-white p-6 shadow-subtle">
        <div class="flex items-center justify-between">
          <p class="text-[11px] font-semibold uppercase tracking-wide text-muted">Quote</p>
          <span class="rounded-full bg-[#e9f8ee] px-2.5 py-1 text-[11px] font-semibold text-[#1e8a4c]">Accepted</span>
        </div>
        <p class="mt-2 text-[15px] font-semibold text-ink">Kitchen Pipe Replacement</p>

        <div class="mt-4 space-y-2 border-t border-line pt-4">
          {lineItems.map((item) => (
            <div class="flex items-center justify-between text-[13px] text-muted">
              <span>{item.label}</span>
              <span class="font-medium text-ink">{item.value}</span>
            </div>
          ))}
        </div>
        <div class="mt-3 flex items-center justify-between border-t border-line pt-3">
          <span class="text-[13px] font-semibold text-ink">Total</span>
          <span class="text-[15px] font-semibold text-ink">$803</span>
        </div>
      </div>

      <!-- Invoice -->
      <div class="reveal reveal-delay-2 rounded-2xl border border-line bg-white p-6 shadow-subtle">
        <div class="flex items-center justify-between">
          <p class="text-[11px] font-semibold uppercase tracking-wide text-muted">Invoice #1048</p>
          <span class="rounded-full bg-[#fdeeea] px-2.5 py-1 text-[11px] font-semibold text-[#c0392b]">Unpaid</span>
        </div>
        <p class="mt-2 text-[15px] font-semibold text-ink">John Smith</p>

        <div class="mt-4 flex items-center justify-between border-t border-line pt-4">
          <span class="text-[13px] text-muted">Total</span>
          <span class="text-[15px] font-semibold text-ink">$803</span>
        </div>

        <button type="button" class="btn mt-6 w-full justify-center !py-2.5">Send Invoice</button>
      </div>
    </div>
  </div>
</section>
