---
import DeviceShowcase from "./DeviceShowcase.astro";
---

<section id="product" class="relative overflow-hidden pb-8 pt-20 sm:pt-28">
  <div class="mx-auto max-w-wrap px-6 text-center">
    <h1 class="reveal mx-auto max-w-3xl text-balance text-[2.25rem] font-semibold leading-[1.12] tracking-tight text-ink sm:text-[3.25rem]">
      Run your field business from anywhere.
    </h1>
    <p class="reveal reveal-delay-1 mx-auto mt-6 max-w-xl text-balance text-[1.05rem] text-muted sm:text-lg">
      SiteMate keeps customers, jobs, quotes, invoices, expenses, and field
      work connected across iPhone, iPad, Mac, and Apple Watch.
    </p>

    <div class="reveal reveal-delay-2 mt-9 flex flex-wrap items-center justify-center gap-3">
      <a href="#waitlist" class="btn">Get Started</a>
      <a href="#how-it-works" class="btn btn-secondary">See how it works</a>
    </div>
  </div>

  <div class="mx-auto mt-16 max-w-wrap px-6 sm:mt-20">
    <DeviceShowcase />
  </div>
</section>
