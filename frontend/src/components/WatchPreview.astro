---

<section class="py-20 sm:py-28">
  <div class="mx-auto max-w-wrap px-6">
    <div class="grid items-center gap-12 sm:grid-cols-2">
      <div class="reveal flex justify-center">
        <div class="w-[150px] rounded-[2.2rem] border-[7px] border-ink bg-ink p-1 shadow-card">
          <div class="flex aspect-[5/6] flex-col items-center justify-center rounded-[1.6rem] bg-black px-4 text-center text-white">
            <p class="text-[10px] font-bold tracking-wider text-accent">JOHNSON</p>
            <p class="mt-1 text-[15px] font-semibold">09:00</p>
            <p class="text-[10px] text-white/60">Kitchen repair</p>
            <span class="mt-3 rounded-full bg-accent px-4 py-1.5 text-[11px] font-semibold">Start Job</span>
          </div>
        </div>
      </div>

      <div class="reveal reveal-delay-1">
        <h2 class="text-balance text-[1.9rem] font-semibold tracking-tight text-ink sm:text-[2.2rem]">
          Your most important actions, one tap away.
        </h2>
        <p class="mt-4 max-w-md text-[1.05rem] text-muted">
          SiteMate Watch is designed for quick actions — not complicated
          workflows.
        </p>

        <div class="mt-6 flex justify-center sm:justify-start">
          <div class="w-[150px] rounded-[2.2rem] border-[7px] border-ink bg-ink p-1 shadow-card">
            <div class="flex aspect-[5/6] flex-col items-center justify-center rounded-[1.6rem] bg-black px-4 text-center text-white">
              <p class="text-[9px] font-bold tracking-wider text-accent">JOB IN PROGRESS</p>
              <p class="mt-1 text-[16px] font-semibold tabular-nums">01:24:38</p>
              <div class="mt-3 flex gap-2">
                <span class="rounded-full border border-white/30 px-3 py-1.5 text-[10px] font-semibold">Pause</span>
                <span class="rounded-full bg-accent px-3 py-1.5 text-[10px] font-semibold">Complete</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
