---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
---

<Layout
  title="About SiteMate"
  description="SiteMate is a cross-device workspace for small field-service businesses, built with FastAPI, PostgreSQL, and Flutter."
>
  <Nav />
  <main class="wrap" style="padding:64px 0">
    <h1>About SiteMate</h1>
    <p style="color:var(--muted);max-width:60ch;margin-top:12px">
      SiteMate is being built as a learning-driven, production-minded project
      exploring modern cross-platform development, native mobile development,
      backend engineering, databases, APIs, offline-first architecture, and
      CI/CD.
    </p>
  </main>
</Layout>
