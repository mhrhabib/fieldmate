---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import Problem from "../components/Problem.astro";
import DashboardPreview from "../components/DashboardPreview.astro";
import JobManagement from "../components/JobManagement.astro";
import QuotesInvoices from "../components/QuotesInvoices.astro";
import MobilePreview from "../components/MobilePreview.astro";
import WatchPreview from "../components/WatchPreview.astro";
import MultiDevice from "../components/MultiDevice.astro";
import Features from "../components/Features.astro";
import Offline from "../components/Offline.astro";
import Technology from "../components/Technology.astro";
import HowItWorks from "../components/HowItWorks.astro";
import CTA from "../components/CTA.astro";
import Footer from "../components/Footer.astro";

// Runs on the SERVER at build time (or per-request if you switch this page to
// SSR later) — never ships to the browser. This is how you pull live data
// from FastAPI into HTML that search engines see immediately, with zero
// client-side loading spinner.
let waitlistCount = 0;
try {
  const res = await fetch(`${import.meta.env.PUBLIC_API_URL}/api/stats`);
  if (res.ok) {
    const data = await res.json();
    waitlistCount = data.waitlist_count;
  }
} catch {
  // Backend not running at build time — fall back gracefully rather than
  // failing the whole build.
}
---

<Layout
  title="SiteMate — One business. One workspace. Every device."
  description="SiteMate keeps customers, jobs, quotes, invoices, expenses, and field work connected across iPhone, iPad, Mac, and Apple Watch."
>
  <Navbar />
  <main>
    <Hero />
    <Problem />
    <DashboardPreview />
    <JobManagement />
    <QuotesInvoices />
    <MobilePreview />
    <WatchPreview />
    <MultiDevice />
    <Features />
    <Offline />
    <Technology />
    <HowItWorks />
    <CTA waitlistCount={waitlistCount} />
  </main>
  <Footer />
</Layout>

