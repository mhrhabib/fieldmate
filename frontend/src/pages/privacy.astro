---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Privacy Policy — SiteMate"
  description="How SiteMate handles your data."
>
  <Navbar />
  <main class="mx-auto max-w-wrap px-6 py-20 sm:py-28">
    <h1 class="text-[2rem] font-semibold tracking-tight text-ink sm:text-[2.4rem]">Privacy Policy</h1>
    <p class="mt-4 max-w-2xl text-[1.05rem] text-muted">
      SiteMate is currently an MVP under active development. A complete
      privacy policy will be published before general availability.
    </p>
  </main>
  <Footer />
</Layout>
